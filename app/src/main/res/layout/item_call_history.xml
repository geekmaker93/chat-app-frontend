<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    app:cardBackgroundColor="@color/chatly_surface"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:id="@+id/call_history_card_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="58dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/call_history_initials"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_avatar"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:textColor="@color/chatly_text_primary"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/call_history_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/chatly_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/call_history_details"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/chatly_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/call_history_timestamp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/chatly_text_secondary"
                    android:textSize="11sp" />

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/call_history_menu"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/call_history_show_actions"
                    android:padding="12dp"
                    app:srcCompat="@drawable/ic_more_vert"
                    app:tint="@color/chatly_text_secondary" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/call_history_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="end"
            android:orientation="horizontal"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/call_history_call_action"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/call_action"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="48dp"
                android:padding="0dp"
                app:cornerRadius="16dp"
                app:icon="@drawable/ic_calls"
                app:iconPadding="0dp"
                app:iconSize="20dp"
                app:iconTint="@color/chatly_primary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/call_history_message_action"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/send_message"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="48dp"
                android:padding="0dp"
                app:cornerRadius="16dp"
                app:icon="@drawable/ic_chats"
                app:iconPadding="0dp"
                app:iconSize="20dp"
                app:iconTint="@color/chatly_primary" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
