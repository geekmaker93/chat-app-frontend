<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Chatly" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/chatly_primary</item>
        <item name="colorSecondary">@color/chatly_secondary</item>
        <item name="colorSurface">@color/chatly_surface</item>
        <item name="colorOnSurface">@color/chatly_text_primary</item>
        <item name="android:colorAccent">@color/chatly_primary</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:statusBarColor">@color/chatly_background</item>
        <item name="android:navigationBarColor">@color/chatly_background</item>
        <item name="android:windowBackground">@color/chatly_background</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Widget.Chatly.Search" parent="Widget.Material3.TextInputLayout.FilledBox">
        <item name="boxBackgroundColor">@color/chatly_surface</item>
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="boxStrokeColor">@color/chatly_primary</item>
        <item name="startIconTint">@color/chatly_text_secondary</item>
    </style>

</resources>
